{
  "name": "gallery",
  "version": "0.1.0",
  "description": "本地相册 - 按时间与地点浏览你的照片",
  "main": "./out/main/index.js",
  "author": "gallery",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "geo:build": "node scripts/build-geo-db.mjs",
    "build:win": "npm run check:resources && npm run build && electron-builder --win --config electron-builder.yml",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run test:ui",
    "check:resources": "node scripts/check-resources.mjs",
    "clean": "node -e \"for (const d of ['out','dist']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "build:dir": "npm run check:resources && npm run build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "exiftool-vendored": "^38.0.1",
    "libheif-js": "^1.23.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.11",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "geokdbush": "^2.1.0",
    "kdbush": "^4.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
